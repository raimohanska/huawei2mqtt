{
  "name": "fusionsolar-report-exporter",
  "version": "0.1.0",
  "private": true,
  "description": "FusionSolar daily report browser export tools",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "browser:install": "playwright install chromium",
    "browser:open": "playwright open --browser chromium",
    "browser:codegen": "playwright codegen --browser chromium",
    "export:today": "node export-today.js",
    "export:reports": "node export-reports.js",
    "test": "node --test --test-concurrency=1 csv-files.test.js export-reports.test.js influx-import.test.js retry.test.js steps.test.js",
    "test:browser": "node --test report-response.test.js",
    "convert:csv": "node convert-csv.js",
    "influx:import": "node influx-import.js"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "dependencies": {
    "exceljs": "4.4.0"
  }
}
