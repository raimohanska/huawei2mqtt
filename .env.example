# Copy this file to .env beside huawei-read.js on the Pi.
# The inverter is reached through the Pi's Wi-Fi connection to its hotspot.
MODBUS_HOST=192.168.200.1
MODBUS_PORT=6607
MODBUS_UNIT=0

# Seconds. These settings worked with the existing Python tester.
MODBUS_TIMEOUT=15
MODBUS_DELAY=2

# Required for the default continuous bridge: node huawei-read.js
# Fill these in locally on the Pi. Plain MQTT/TCP with username/password.
# Example: mqtt://192.168.1.10:1883 (actual broker address is not known yet).
MQTT_BROKER_URL=
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=huawei

# Home Assistant must already have its MQTT integration connected to this broker.
HA_DISCOVERY_PREFIX=homeassistant
HA_DEVICE_NAME="Huawei Inverter"

# Seconds between full read/publish cycle starts. Requests never overlap.
POLL_INTERVAL=15
